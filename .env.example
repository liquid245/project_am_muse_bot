# Telegram bot configuration
# На Bothost BOT_TOKEN инжектит платформа: свой токен кладём в BOT_TOKEN_2 (приоритет), BOT_TOKEN_1 — резерв
BOT_TOKEN_2=your-telegram-bot-token
BOT_TOKEN_1=
BOT_TOKEN=
ADMIN_IDS=123456789,987654321
ADMIN_USER_ID=123456789
MANAGER_USER_ID=987654321

# Webhook (в проде обязательно: без секрета эндпоинт принимает любой POST как апдейт Telegram)
WEBHOOK_URL=https://your-domain.example
WEBHOOK_PATH=/webhook-<random-32-hex>
WEBHOOK_SECRET=<random-43-chars-urlsafe>

# GitHub integration
GITHUB_TOKEN=github_pat_example
REPO_NAME=username/project_am_muse

# Admin notifications
ADMIN_CHAT_ID=-1003497103344
ADMIN_TOPIC_ID=43

# Site metadata
SITE_ADRESS=https://your-domain.example
MASTER_USERNAME=baegon
BOT_USERNAME=am_muse_bot

# Payments
PHONE_NUMBER=+79000000000
BANK_NAME=Сбербанк

# Runtime
DEBUG=false
